{
  "name": "tenka-fubu",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "postinstall": "node tools/dependencies/pixi-8.19-patch.mjs",
    "predev": "node tools/dependencies/pixi-8.19-patch.mjs && npm run wasm:check",
    "prebuild": "node tools/dependencies/pixi-8.19-patch.mjs && npm run wasm:check",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.core.json --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:core": "vitest run --project core --passWithNoTests",
    "test:ui": "vitest run --project ui --passWithNoTests",
    "test:app": "vitest run --project app --passWithNoTests",
    "test:golden": "vitest run tests/golden",
    "test:perf": "vitest run --workspace tests/perf/vitest.gate.workspace.ts --minWorkers=1 --maxWorkers=1",
    "test:coverage": "vitest run --coverage --coverage.all --coverage.provider=v8 --coverage.include='src/core/**/*.ts' --coverage.exclude='src/core/**/*.spec.ts' --coverage.reportOnFailure --coverage.thresholds.lines=80 --coverage.thresholds.branches=70",
    "test:coverage:report": "vitest run --coverage --coverage.all --coverage.provider=v8 --coverage.include='src/core/**/*.ts' --coverage.exclude='src/core/**/*.spec.ts' --coverage.reportOnFailure",
    "golden:update": "UPDATE_GOLDEN=1 vitest run tests/golden",
    "e2e": "npm run build && playwright test",
    "e2e:visual": "playwright test e2e/visual.spec.ts",
    "e2e:gallery": "playwright test --config tests/browser/playwright.gallery.config.ts",
    "e2e:visual:update": "npm run build && UPDATE_VISUAL=1 playwright test e2e/visual.spec.ts --update-snapshots",
    "bench": "vitest bench tests/perf --project core --minWorkers=1 --maxWorkers=1 --reporter ./tools/ci/benchmark-samples-reporter.ts",
    "simulate": "tsx tools/simulate.ts",
    "validate:data": "tsx tools/validate.ts && tsx tools/scan-simplified.ts && tsx tools/check-font-coverage.ts",
    "scan:simplified": "tsx tools/scan-simplified.ts",
    "font:subset": "tsx tools/subset-font.ts",
    "gen:assets": "tsx tools/gen-assets.ts",
    "atlas:build": "tsx tools/build-atlas.ts",
    "validate:assets": "tsx tools/validate-assets.ts",
    "validate:bundle": "tsx tools/ci/bundle-budget.ts",
    "wasm:build": "tsx tools/wasm/build.ts --build",
    "wasm:check": "tsx tools/wasm/build.ts --check"
  },
  "dependencies": {
    "idb-keyval": "^6.2.1",
    "lz-string": "^1.5.0",
    "pixi.js": "8.19.0",
    "zod": "^3.23.8",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@playwright/test": "^1.48.0",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.7.5",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/subset-font": "^2.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "@vitest/coverage-v8": "^2.1.3",
    "axe-core": "^4.14.0",
    "eslint": "^9.13.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.13",
    "jsdom": "^25.0.1",
    "pngjs": "^7.0.0",
    "prettier": "^3.3.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "subset-font": "^2.5.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.9.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.3"
  }
}
